          "transliteration": "ḥtp-ḏj-nsw Wsjr",
          "translation": "A royal offering of Osiris,"
        },
        {
          "hieroglyphs": "",
          "transliteration": "prt-r-ḫrw t ḥnqt kꜣ ꜣpd fqꜣw",
          "translation": "a mortuary offering of bread, beer, oxen, fowl, cakes,"
        },
        {
          "hieroglyphs": "",
          "transliteration": "ḥs(t) ẖnw Jmn Jmn-jr-ḏj-s(t)",
          "translation": "(to) the singer of the interior of Amun Amenirdis."
        }
